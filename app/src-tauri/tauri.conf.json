{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Blitztext",
  "version": "0.1.0",
  "identifier": "io.julasim.blitztext",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blitztext",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "mini",
        "title": "Blitztext Mini",
        "url": "/?widget=mini",
        "width": 420,
        "height": 240,
        "minWidth": 420,
        "minHeight": 240,
        "maxWidth": 420,
        "maxHeight": 240,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/sidecar/**/*"
    ],
    "windows": {
      "wix": {
        "language": ["en-US", "de-DE"]
      }
    }
  }
}
