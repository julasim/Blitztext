{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Rechte des Hauptfensters: Fenstersteuerung, Dateidialoge, Benachrichtigungen. Kein fs/shell — Dateien fasst ausschließlich der Python-Sidecar an, gespawnt über std::process::Command. Keine globalen Shortcuts, kein Mikrofon.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-is-maximized",
    "dialog:default",
    "dialog:allow-confirm",
    "dialog:allow-ask",
    "dialog:allow-message",
    "notification:default"
  ]
}
