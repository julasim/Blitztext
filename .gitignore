# Python
__pycache__/
.pytest_cache/
*.py[cod]
*$py.class
*.egg-info/
.venv/
# auch -old (Rückfall-venv nach Stack-Wechseln) und -next (Parallel-Aufbau)
.venv-sidecar*/
venv/
env/

# PyInstaller output (build-sidecar.spec) und das portable Paket
build/
dist/
release/
*.manifest
*.spec.bak

# Tauri / React / Node
app/node_modules/
app/dist/
app/src-tauri/target/
app/.vite/
app/*.log

# Benchmark: echte Aufnahmen und ihre Auswertung. Das sind Bauberatungen —
# die haben im Repo nichts verloren, auch nicht als Dateiname in einer
# Ergebnisdatei. Code unter benchmark/ bleibt getrackt.
benchmark/data/
benchmark/results/
benchmark/.work/

# Gebündelter Sidecar (~4,8 GB PyInstaller-Output). Der Platzhalter bleibt
# getrackt: fehlt der Ordner, bricht schon `cargo check` am Resource-Glob
# aus tauri.conf.json — mit einer Meldung, die nach Config-Fehler aussieht.
app/src-tauri/binaries/sidecar/*
!app/src-tauri/binaries/sidecar/PLATZHALTER.txt

# Lokales Claude-Tooling (Workspace-Konvention: nie committen)
.claude/

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs & local state
*.log
*.err
